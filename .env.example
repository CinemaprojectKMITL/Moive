NODE_ENV=development
API_PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/cinema?replicaSet=rs0
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGIN=http://localhost:5173
BOOKING_HOLD_MINUTES=5
BOOKING_CLEANUP_INTERVAL_MS=10000
STRICT_RACE_CANCEL_BOTH=true
RACE_WINDOW_MS=300
# Backend only. Use a registered Thai mobile, 13-digit ID, or 15-digit PromptPay wallet ID.
PAYMENT_QR_TARGET=YOUR_PROMPTPAY_TARGET
# Opt-in development simulation. Both are ignored/blocked in production.
ENABLE_DEBUG_PAYMENT=false
VITE_ENABLE_DEBUG_PAYMENT=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
